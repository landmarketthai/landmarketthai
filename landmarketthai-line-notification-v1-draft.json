        "responseBody": "{\"accepted\":true,\"code\":\"PREVIEW_QUEUED\"}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "06f33b69-4ace-4935-b5bf-6474fe796c9f",
      "name": "Build Safe LINE Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        230
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e = $input.first().json;\nconst groupId = \"REPLACE_WITH_LINE_GROUP_ID\"; // Must come from verified LINE webhook source.groupId\nif (!/^C[0-9a-f]{32}$/i.test(groupId)) throw new Error(\"LINE GROUP ID NOT CONFIGURED — no message sent\");\nconst type = { buyer: \"ผู้สนใจซื้อ\", owner: \"เจ้าของทรัพย์\", partner: \"นายหน้าพาร์ทเนอร์\" }[e.lead_type];\nif (!type || !e.valid) throw new Error(\"Invalid Lead Event\");\nconst text = \"🔔 LandmarketThai (ทดสอบ)\\\\nมี Lead ใหม่: \" + type + \"\\\\nสถานะ: รอทีมงานตรวจสอบ\\\\nCRM: https://landmarketthai.com/admin/leads\";\nreturn [{json: {to:groupId,messages:[{type:\"text\",text}],lead_id:e.lead_id}}];"
      }
    },
    {
      "id": "7cbd623d-bbcb-4910-aa1f-577ef4881c86",
      "name": "LINE Push (Credentials Required)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        230
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Line-Retry-Key",
              "value": "={{ $json.lead_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.to, messages: $json.messages }) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
