    {
      "id": "da8a7719-93bc-437a-a640-e3f691ff872f",
      "name": "Validate Lead Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json.body ?? {};\nconst validLeadId = typeof input.lead_id === \"string\" && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(input.lead_id);\nconst validType = [\"buyer\", \"owner\", \"partner\"].includes(input.lead_type);\nconst validEnvironment = input.environment === \"preview\";\nconst valid = validLeadId && validType && validEnvironment;\nreturn [{ json: { valid, lead_id: valid ? input.lead_id : null, lead_type: valid ? input.lead_type : null, environment: valid ? \"preview\" : null } }];"
      }
    },
    {
      "id": "e3b9fd56-44dd-4560-9dc9-a9ccdc1fbce6",
      "name": "Valid Preview Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "valid-bool-1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
