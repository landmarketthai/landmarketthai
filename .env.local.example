# Neon Postgres (server-only; never expose this as NEXT_PUBLIC_*)
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/landmarketthai?sslmode=require

# Neon Managed Better Auth (public auth endpoint; no database password here)
NEXT_PUBLIC_NEON_AUTH_URL=https://your-neon-auth-host.neon.tech/landmarketthai/auth

# DigitalOcean Spaces (S3-compatible)
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=landmarketthai
DO_SPACES_KEY=your-access-key
DO_SPACES_SECRET=your-secret-key
DO_SPACES_CDN_BASE=https://landmarketthai.sgp1.cdn.digitaloceanspaces.com

# n8n Webhook (async side-effects)
NEXT_PUBLIC_LINE_OA_URL=https://lin.ee/8p064f7
N8N_WEBHOOK_LEADS=https://your-n8n.com/webhook/leads

# Site
NEXT_PUBLIC_SITE_URL=https://landmarketthai.com
